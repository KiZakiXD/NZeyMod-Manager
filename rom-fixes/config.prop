# NZeyMod user config - file aktif ada di /sdcard/NZeyMod/config.prop (edit di sana, lalu reboot)
# operator_mode: random | telkomsel | indosat | xl | axis | tri | smartfren
operator_mode=random
# identity_mode: full | basic (hanya dipakai aplikasi NZeyMod Identity, tidak dibaca nzeymod.sh)
identity_mode=full
# keybox_path: lokasi cadangan keybox di dalam VM
keybox_path=/sdcard/NZeyMod/keybox.xml
# randomize_on_boot: true | false (hanya dipakai aplikasi, nzeymod.sh hanya membuat identitas bila identity.json belum ada)
randomize_on_boot=true
# wipe_profiles_on_randomize: true | false (hanya dipakai aplikasi)
wipe_profiles_on_randomize=false
# show_toast: true | false (hanya dipakai aplikasi)
show_toast=true
# Catatan: identitas device (Pixel 5, redfin) tertanam di build.prop ROM.
# Ganti keybox: pakai NZeyMod Manager > Ganti Keybox, atau timpa /sdcard/NZeyMod/keybox.xml lalu reboot.
# Modul tambahan: install manual via aplikasi Magisk di dalam VM, atau minta repack.
